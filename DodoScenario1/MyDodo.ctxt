#BlueJ class context
comment0.target=MyDodo
comment0.text=\r\n\r\n\ @author\ Sjaak\ Smetsers\ &\ Renske\ Smetsers-Weeda\r\n\ @version\ 3.0\ --\ 20-01-2017\r\n
comment1.params=
comment1.target=MyDodo()
comment10.params=
comment10.target=void\ turn180()
comment10.text=\r\n\ Dodo\ turns\ 180\ degrees,\ facing\ the\ opposite\ direction.\r\n
comment11.params=
comment11.target=void\ climbOverFence()
comment11.text=\r\n\ Initial\ situation\:\ Dodo\ is\ facing\ a\ fence\ on\ his\ right\ side.\r\n\ Final\ situation\:\ Dodo\ is\ on\ the\ other\ side\ of\ the\ fence,\ with\ the\ fence\ to\ his\ back.\r\n\ \ \ \ \ \r\n\ Dodo\ first\ rotates,\ facing\ upward,\ then\ taking\ a\ step\ forward,\ and\ then\ \r\n\ rotates\ normally.\ Then\ taking\ 2\ steps,then\ rotating\ downwards\ and\ take\ \r\n\ 1\ step\ more.finally,\ the\ dodo\ rotates\ once\ more\ to\ have\ the\ same\ rotation\r\n\ as\ the\ initial\ situation.\r\n
comment12.params=
comment12.target=void\ stepOneCellBackwards()
comment12.text=\r\n\ Dodo\ turns\ around\ 180\ degrees,\ then\ moving\ one\ step.\ After\ that\ the\ \r\n\ dodo\ turns\ again,\ to\ the\ original\ direction.\r\n
comment13.params=
comment13.target=boolean\ grainAhead()
comment13.text=\r\n\ dodo\ moves\ forward,\ checking\ if\ there\ is\ grain\ on\ his\ position,\ then\ \r\n\ then\ takes\ a\ step\ back,\ returning\ a\ value\ that\ is\ true\ /\ false\r\n
comment14.params=
comment14.target=void\ goToEgg()
comment14.text=\r\n\ Initial\ situation\:\ egg\ lies\ ...\ cells\ ahead\ of\ the\ dodo.\ The\ cells\ \r\n\ between\ are\ empty.\r\n\ \r\n\ Final\ situation\:\ Dodo\ is\ standing\ still\ on\ top\ of\ the\ egg.\r\n
comment15.params=
comment15.target=void\ goBackToStartOfRowAndFaceBack()
comment15.text=\r\n\ Dodo\ walks\ to\ the\ world\ border,\ then\ turn\ to\ face\ his\ original\ position\r\n
comment16.params=
comment16.target=void\ walkToWorldEdgeClimbingOverFences()
comment16.text=\r\n\ Dodo\ walks\ to\ the\ world\ border\ while\ also\ checking\ if\ there\ are\ fences\r\n\ ahead.\ If\ there\ is\ a\ fence\ ahead,\ the\ dodo\ will\ climb\ over\ the\ fence\ \r\n\ and\ continue\ his\ path\ to\ the\ world\ border.\ \r\n\ \r\n\ The\ dodo\ will\ also\ check\ if\ there\ are\ empty\ nests.\ if\ so,\ it\ will\ lay\r\n\ an\ egg\r\n
comment17.params=
comment17.target=void\ pickUpGrainsAndPrintCoordinates()
comment17.text=\r\n\ if\ the\ dodo\ picks\ up\ a\ grain,\ the\ coordinates\ of\ the\ grain\ will\ be\r\n\ printed\ in\ the\ console.\r\n
comment18.params=
comment18.target=void\ walkToWorldEdgeWhileCheckingNests()
comment18.text=\r\n\ The\ dodo\ will\ walk\ to\ the\ world\ border\ while\ checking\ empty\ nests\ on\r\n\ his\ path.\ if\ there\ is\ an\ empty\ nest,\ the\ dodo\ will\ lay\ an\ egg.\r\n
comment19.params=
comment19.target=void\ walkAroundFencedArea()
comment2.params=
comment2.target=void\ act()
comment3.params=
comment3.target=void\ move()
comment3.text=\r\n\ Move\ one\ cell\ forward\ in\ the\ current\ direction.\r\n\ \r\n\ <P>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <P>\ Final\:\ If\ possible,\ Dodo\ has\ moved\ forward\ one\ cell\r\n\r\n
comment4.params=
comment4.target=boolean\ canMove()
comment4.text=\r\n\ Test\ if\ Dodo\ can\ move\ forward,\ (there\ are\ no\ obstructions\r\n\ \ \ \ or\ end\ of\ world\ in\ the\ cell\ in\ front\ of\ her).\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <p>\ Final\:\ \ \ Same\ as\ initial\ situation\r\n\ \r\n\ @return\ boolean\ true\ if\ Dodo\ can\ move\ (no\ obstructions\ ahead)\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ false\ if\ Dodo\ can't\ move\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ (an\ obstruction\ or\ end\ of\ world\ ahead)\r\n
comment5.params=
comment5.target=void\ hatchEgg()
comment5.text=\r\n\ Hatches\ the\ egg\ in\ the\ current\ cell\ by\ removing\r\n\ the\ egg\ from\ the\ cell.\r\n\ Gives\ an\ error\ message\ if\ there\ is\ no\ egg\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world.\ There\ is\ an\ egg\ in\ Dodo's\ cell.\r\n\ <p>\ Final\:\ Dodo\ is\ in\ the\ same\ cell.\ The\ egg\ has\ been\ removed\ (hatched).\ \ \ \ \ \r\n
comment6.params=
comment6.target=int\ getNrOfEggsHatched()
comment6.text=\r\n\ Returns\ the\ number\ of\ eggs\ Dodo\ has\ hatched\ so\ far.\r\n\ \r\n\ @return\ int\ number\ of\ eggs\ hatched\ by\ Dodo\r\n
comment7.params=distance
comment7.target=void\ jump(int)
comment7.text=\r\n\ Move\ given\ number\ of\ cells\ forward\ in\ the\ current\ direction.\r\n\ \r\n\ <p>\ Initial\:\ \ \ \r\n\ <p>\ Final\:\ \ \r\n\ \r\n\ @param\ \ \ int\ distance\:\ the\ number\ of\ steps\ made\r\n
comment8.params=
comment8.target=void\ walkToWorldEdge()
comment8.text=\r\n\ Walks\ to\ edge\ of\ the\ world\ printing\ the\ coordinates\ at\ each\ step\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ on\ West\ side\ of\ world\ facing\ East.\r\n\ <p>\ Final\:\ \ \ Dodo\ is\ on\ East\ side\ of\ world\ facing\ East.\r\n
comment9.params=
comment9.target=boolean\ canLayEgg()
comment9.text=\r\n\ Test\ if\ Dodo\ can\ lay\ an\ egg.\r\n\ \ \ \ \ \ \ \ \ \ (there\ is\ not\ already\ an\ egg\ in\ the\ cell)\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <p>\ Final\:\ \ \ Same\ as\ initial\ situation\r\n\ \r\n\ @return\ boolean\ true\ if\ Dodo\ can\ lay\ an\ egg\ (no\ egg\ there)\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ false\ if\ Dodo\ can't\ lay\ an\ egg\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ (already\ an\ egg\ in\ the\ cell)\r\n
numComments=20
